# Copy to .env for local development. The defaults match the database that
# `npm run db:start` (or `docker compose up`) brings up on port 5433.

DATABASE_URL="postgresql://shiftsync:shiftsync@127.0.0.1:5433/shiftsync"

# Optional, and only needed when DATABASE_URL points at a transaction pooler
# (Neon's `-pooler` host, PgBouncer, Supabase port 6543). Set it to the direct,
# unpooled connection string. Migrations and the realtime LISTEN connection use
# it, because a transaction pooler does not support session-level LISTEN.
# DIRECT_DATABASE_URL="postgresql://…"

# Generate a real one with: npx auth secret
AUTH_SECRET="replace-me-generate-with-npx-auth-secret"
AUTH_TRUST_HOST="true"

# Optional. Only used to build links inside simulated emails.
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
